# URL này chỉ dùng làm tham chiếu.
# Trong Expo dev, URL được tự động phát hiện từ host dev server qua src/utils/env.js
# Xem: docs/skills/expo-dev.md — phần "Cấu hình API URL"

# Android emulator (ADB loopback)
# API_BASE_URL=http://10.0.2.2:3000/api

# iOS simulator
# API_BASE_URL=http://localhost:3000/api

# Thiết bị thật (thay bằng IP LAN của máy chạy BE)
# API_BASE_URL=http://192.168.1.x:3000/api

# Production
# API_BASE_URL=https://your-production-api.com/api
